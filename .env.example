# Copy to .env and fill in. Never commit .env.

# Claude (module ID, plug checks, questions). Without it, plug checks fall back to the serial test.
ANTHROPIC_API_KEY=

# LiveKit: Chert carries FaceTime audio/video through a LiveKit room we own.
# Free project at https://cloud.livekit.io -> Settings -> Keys. Chert requires wss://.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Name the worker registers under; run `chert dev --agent <this name>`
AGENT_NAME=pinpoint

# Chert FaceTime API (dashboard -> Developer -> Project API keys)
CHERT_FACETIME_API_KEY=       # ftk_...
CHERT_PROJECT_ID=             # project UUID

# Chert Messaging (iMessage) API
CHERT_MESSAGING_SECRET=       # tenant signing secret (shown once at registration)
CHERT_TENANT=                 # tenant slug (only needed for multi-tenant accounts)
CHERT_MESSAGING_WEBHOOK_SECRET=  # printed by: python -m tools.chert_setup subscribe-imessage <url>
CHERT_IMESSAGE_TO=            # builder's phone (+1555...) or Apple ID for the recap

# Pinpoint
PINPOINT_KIT=elegoo           # elegoo = judge-chosen breadboard builds (default) | grove = Base Shield script
PINPOINT_PLANNER_EFFORT=low      # Claude effort for designing builds: low (fastest) / medium / high
PINPOINT_VOICE_RATE=+20%      # Faster FaceTime speech; adjust down if it is hard to follow
PINPOINT_ARDUINO_CLI=         # path to arduino-cli if it isn't on PATH (see python -m tools.setup_arduino)
PINPOINT_GUIDANCE=snapshot    # snapshot = phone held up on request (default) | live = phone on a stand
PINPOINT_MODE=                # voice | visual | blank = ask at the start of the call
PINPOINT_SERIAL_PORT=auto     # auto | none | COM5 | /dev/ttyACM0
PINPOINT_STT_MODEL=base.en    # faster-whisper: tiny.en (fastest) / base.en / small.en (most accurate)
PINPOINT_CAMERA=0             # webcam index for --source webcam
